# ==========================================================================
# EDC — Entreprise Dia Construction
# Configuration Apache / LiteSpeed (hébergement mutualisé cPanel — dakarweb.net)
# À déployer à la racine du site (public_html).
# ==========================================================================

DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Les fichiers et dossiers existants sont servis tels quels (assets, images, .html)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. Routage propre : /equipe -> /equipe.html (pages pré-rendues)
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]

  # 3. Fallback SPA : toute autre route -> index.html
  RewriteRule ^ index.html [L]
</IfModule>

# --- Compression -----------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- Cache -----------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  # Assets hashed par Vite : cache long
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  # HTML : toujours revalidé
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# --- En-têtes de sécurité --------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
